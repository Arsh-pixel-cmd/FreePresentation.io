# ============================================================================
# FreePresentation.io — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Keys marked [REQUIRED] are needed to run the app.
# Keys marked [OPTIONAL] add extra functionality but the app works without them.
# ============================================================================

# ---------------------------------------------------------------------------
# AI Models [REQUIRED — at least one NVIDIA key needed]
# ---------------------------------------------------------------------------
# Get free API keys from https://build.nvidia.com
# Primary model: NVIDIA Nemotron 3 Ultra (fast, used first)
NVIDIA_NEMOTRON_API_KEY=your_nvidia_nemotron_key_here

# Backup model: Google Gemma 4 31B via NVIDIA (used if primary times out)
NVIDIA_GEMMA_API_KEY=your_nvidia_gemma_key_here

# ---------------------------------------------------------------------------
# Gemini API Key [OPTIONAL — fallback for PDF parsing / OCR]
# ---------------------------------------------------------------------------
# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Images [OPTIONAL — falls back to Pollinations.ai if not set]
# ---------------------------------------------------------------------------
# Create an app at https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# ---------------------------------------------------------------------------
# Redis & Queues — Upstash [OPTIONAL — rate limiting & job queue]
# ---------------------------------------------------------------------------
# Create a Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
QSTASH_TOKEN=your_qstash_token_here
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key_here
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key_here

# ---------------------------------------------------------------------------
# Local Redis Queue Config [OPTIONAL — if using BullMQ instead of Upstash]
# ---------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=

# ---------------------------------------------------------------------------
# App Config
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cloudflare Turnstile [OPTIONAL — invisible bot protection for generation]
# ---------------------------------------------------------------------------
# Create a Turnstile widget at https://dash.cloudflare.com/ -> Turnstile
# If omitted or left as placeholder, Turnstile verification passes automatically in dev.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ---------------------------------------------------------------------------
# Monitoring & Analytics [OPTIONAL]
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---------------------------------------------------------------------------
# Other PDF OCR Fallbacks [OPTIONAL]
# ---------------------------------------------------------------------------
UPSTASH_OCR_API_URL=your_upstash_ocr_api_url_here
UPSTASH_OCR_API_TOKEN=your_upstash_ocr_api_token_here
DASHSCOPE_API_KEY=your_dashscope_key_here
